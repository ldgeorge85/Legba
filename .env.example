# Legba — Environment Configuration
# Copy to .env and fill in your values.
#
# ─── SOURCE OF TRUTH ────────────────────────────────────────────────────────
# At RUNTIME the registry is authoritative: the typed `stack_components` table
# (the StackRegistry — see src/legba/data/registry/stack.py) holds the live
# LLM / embedding / NLP / substrate endpoints, model names and credential refs.
# Configure/edit them through the registry API (`/api/v1/registry/stack`) or
# the in-app Settings panel — NOT by editing this file after bring-up.
#
# `.env` only does three things:
#   1. SEEDS those `stack_components` rows ONCE at bring-up, via
#      scripts/bringup_register_stack.py — the seed vars are:
#        LEGBA_LLM_API_ENDPOINT / LEGBA_LLM_MODEL_NAME   (→ llm_provider row)
#        LEGBA_EMBED_MODEL_NAME                          (→ embedding row)
#        LEGBA_NLP_API_ENDPOINT                          (→ nlp_service row)
#      Editing them later has NO effect on a running deployment — the registry
#      row already exists; change it via the API/Settings panel instead.
#   2. LOADS credentials into the vault ONCE at bring-up, via
#      scripts/bringup_vault_load.py (OPENAI_API_KEY, CONSULT_API_KEY,
#      MODELS_API_USER/PASS, source API keys, …). The registry only ever stores
#      vault REFERENCES, never plaintext.
#   3. Holds the few genuine long-term runtime vars the substrate needs before
#      the registry is reachable: the registry DSN + master encryption key
#      (LEGBA_DATA_REGISTRY_DSN / LEGBA_DATA_MASTER_KEY), live auth tokens
#      (LEGBA_REGISTRY_API_TOKEN, LEGBA_NATS_TOKEN, LEGBA_REDIS_PASSWORD,
#      perimeter basic-auth), and the live media endpoint (LEGBA_MEDIA_API_URL).
#
# Vars that were read by NOTHING were removed: OPENAI_BASE_URL, OPENAI_MODEL,
# CONSULT_MODEL, CONSULT_LLM_PROVIDER, MEMORY_EMBEDDING_MODEL,
# LLM_MAX_TOKENS / LLM_TEMPERATURE / LLM_TOP_P. The LLM/embedding model
# parameters (max_tokens, tier, dim, …) live in the registry component body.
# ─────────────────────────────────────────────────────────────────────────────

# --- Vault-loaded credentials (scripts/bringup_vault_load.py) ---
# Read once at bring-up and loaded into the credentials vault; descriptors
# reference them by vault path, never by env var.
# Primary LLM endpoint key (vault: llm.primary.api_key)
OPENAI_API_KEY=your-api-key-here
# Consultation engine — Anthropic key (vault: llm.anthropic.api_key)
CONSULT_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# --- Model-serving endpoints (stack registry) ---
# The primary LLM (gpt-oss-120b) and the embedding model (BAAI/bge-m3) are
# served out-of-process by one OpenAI-compatible vLLM endpoint; the baseline
# NLP service (translate/classify/extract/summarize) is a separate endpoint.
# These are read by scripts/bringup_register_stack.py at registration time —
# set them to your real, deployment-specific hosts and served model names.
LEGBA_LLM_API_ENDPOINT=https://llm.example.internal
LEGBA_NLP_API_ENDPOINT=https://nlp.example.internal
LEGBA_LLM_MODEL_NAME=gpt-oss-120b
LEGBA_EMBED_MODEL_NAME=bge-m3
MODELS_API_USER=your-nlp-basic-auth-user
MODELS_API_PASS=your-nlp-basic-auth-pass
# Optional defense-in-depth shared secret for legba-models. When set on the
# legba-models container (as LEGBA_MODELS_API_SECRET) every inference endpoint
# requires a matching X-Models-Secret header. Set the SAME value here so the
# runtime's nlp client presents it. Leave BLANK to disable (dev default).
MODELS_API_SECRET=

# --- Source API keys ---
# Loaded into the vault by scripts/bringup_vault_load.py and/or expanded
# into seeded source descriptors by scripts/seed_sources.py.
# NASA FIRMS
FIRMS_MAP_KEY=your-firms-map-key
# FRED (Federal Reserve Economic Data)
FRED_API_KEY=your-fred-key
# NVD (National Vulnerability Database)
NVD_API_KEY=your-nvd-key
# UN Comtrade
COMTRADE_PRIMARY_KEY=your-comtrade-key
# Event Registry / NewsAPI.ai
EVENT_REGISTRY_API_KEY=your-event-registry-key
# AlienVault OTX (optional)
# OTX_API_KEY=your-otx-key

# --- S-2 keyed source descriptors (Bucket B) ---
# Plaintexts for the vault refs declared in descriptors/source_*.yaml
# (acled / gdelt_bigquery / mediacloud / opensanctions_api / telegram).
# Placeholders only — set real values, then promote into the credential
# vault with scripts/bringup_vault_load.py. The descriptors ship state:
# draft and only activate after the operator stores these and flips them
# (see each descriptor's header for the exact steps).
# ACLED access key → vault id source.acled.api_key (mapped from ACLED_API_KEY
# by bringup_vault_load.py). The registration email is NOT a secret — set it
# in descriptors/source_acled_conflict.yaml config.email. ACLED_EMAIL is kept
# as an operator convenience note for which address that key belongs to.
ACLED_EMAIL=
ACLED_API_KEY=
# GDELT: the GCP service-account JSON for BigQuery, as a single line
# (vault id: source.gdelt.bigquery_sa).
GDELT_BQ_SERVICE_ACCOUNT_JSON=
# MediaCloud API key (vault id: source.mediacloud.api_key).
MEDIACLOUD_API_KEY=
# OpenSanctions API key — api mode only; the bulk_csv descriptor is keyless
# (vault id: source.opensanctions.api_key).
OPENSANCTIONS_API_KEY=
# Telegram MTProto credentials from https://my.telegram.org plus a base64
# Telethon session blob generated out-of-band via telethon_auth.py
# (vault ids: source.telegram.api_id / .api_hash / .session).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_B64=

# --- legba.data package (L-001) bootstrap ---
# Per design/legba_topology_redesign.md §2.5: registry connection + master
# encryption key + default stack IDs are the ONLY long-term env vars.
# Everything else flows through the stack registry once it lands (L-111).

# Substrate store endpoints (LEGBA_DATA_* prefix; falls back to legacy names).
# Inside docker: use service names (postgres, qdrant, etc.). On host: use 127.0.0.1.
LEGBA_DATA_PG_HOST=postgres
LEGBA_DATA_PG_PORT=5432
LEGBA_DATA_PG_USER=legba
LEGBA_DATA_PG_PASSWORD=legba
LEGBA_DATA_PG_DB=legba
LEGBA_DATA_PG_POOL_MIN=1
LEGBA_DATA_PG_POOL_MAX=10

LEGBA_DATA_QDRANT_HOST=qdrant
LEGBA_DATA_QDRANT_PORT=6333
LEGBA_DATA_QDRANT_GRPC_PORT=6334

LEGBA_DATA_REDIS_HOST=redis
LEGBA_DATA_REDIS_PORT=6379
LEGBA_DATA_REDIS_DB=0
LEGBA_DATA_REDIS_MAXMEMORY_POLICY=allkeys-lru
LEGBA_DATA_REDIS_EMBED_TTL=86400

LEGBA_DATA_NATS_URL=nats://nats:4222

# Embedding model — BAAI/bge-m3; name read from env.
LEGBA_DATA_EMBED_MODEL=BAAI/bge-m3
LEGBA_DATA_EMBED_DIM=1024

# Registry bootstrap (topology §2.5 — only long-term env vars).
LEGBA_DATA_REGISTRY_DSN=postgresql://legba:legba@postgres:5432/legba
LEGBA_DATA_MASTER_KEY=replace-with-base64-32-bytes
LEGBA_DATA_DEFAULT_PG=pg.cluster_main
LEGBA_DATA_DEFAULT_REDIS=kv.redis.cluster_main
LEGBA_DATA_DEFAULT_NATS=bus.nats.cluster_main
LEGBA_DATA_DEFAULT_VECTOR=vector.qdrant.cluster_main
LEGBA_DATA_DEFAULT_EMBEDDING=embed.primary.openai_compat
LEGBA_DATA_DEFAULT_LLM=

# --- Dapr actor state store (P-14) ---
# Full Postgres DSN for Dapr's actor state store, resolved by the daprd
# sidecar's local.env secret store (dapr/components/secretstore.yaml) and
# referenced from dapr/components/statestore.yaml via secretKeyRef — so no
# password is committed in the component YAML. Targets the DEDICATED `dapr`
# database (created by the dapr-init-db one-shot), NOT the substrate `legba`
# DB, to keep actor-state churn off the substrate.
LEGBA_DAPR_PG_CONNSTRING=host=postgres user=legba password=legba dbname=dapr sslmode=disable

# --- B-1: substrate auth (stop publishing the substrate) ---
# All substrate host ports now bind 127.0.0.1 (only Caddy 80/443 stays
# public); these two keys add in-cluster auth on top. Empty = unauthenticated
# (pre-cutover dev behaviour). Generate + set before the cutover redeploy:
#   openssl rand -hex 32
# LEGBA_NATS_TOKEN: nats-server --auth token; threaded to every NATS client
# (NatsConfig/NatsStore, registry health probes, dapr pubsub.yaml via the
# local.env secret store).
LEGBA_NATS_TOKEN=
# LEGBA_REDIS_PASSWORD: redis --requirepass; threaded to every redis client
# (RedisConfig/RedisStore, registry health probes, compose healthcheck).
LEGBA_REDIS_PASSWORD=

# --- Caddy perimeter auth (public surface) ---
# Public site domain Caddy serves + auto-obtains a Let's Encrypt cert for
# (docker/Caddyfile reads it as {$LEGBA_PUBLIC_DOMAIN:localhost}). Set your real
# domain; unset falls back to `localhost` with Caddy's internal CA (local dev).
LEGBA_PUBLIC_DOMAIN=legba.example.com
# Bearer the registry enforces; caddy injects it upstream after basic_auth.
# Set to a 32-byte hex (openssl rand -hex 32).
# B-2 FAIL-CLOSED: unset/empty token means every guarded request gets HTTP
# 503 unless LEGBA_DEV_MODE=1 (below) is set explicitly.
LEGBA_REGISTRY_API_TOKEN=
# Caddy perimeter basic_auth bcrypt hash for user `legba` (NOT committed to the
# repo — read by docker/Caddyfile via {$LEGBA_BASIC_AUTH_HASH}). Generate with:
#   caddy hash-password --plaintext '<password>'
# IMPORTANT: single-quote the value — a bcrypt hash contains '$' which
# docker compose env_file otherwise interpolates away (mangles the hash →
# basic_auth silently rejects every password). e.g. LEGBA_BASIC_AUTH_HASH='$2a$14$...'
LEGBA_BASIC_AUTH_HASH=

# --- A-2: hosted media-extraction endpoint (media loop close) ---
# Base URL of the hosted media service (/transcribe /caption /ocr /detect).
# UNSET = the path is a declared seam that fails loud: process_media enqueue
# and execution REFUSE (typed error, no row written) and media:"eager"
# sources refuse activation. No stub transcript/caption ever lands in the
# shared signal pool. Auth reuses MODELS_API_USER / MODELS_API_PASS.
#
# To DEPLOY + TEST the loop in-stack (D2 PREP), bring up the `media` profile
# (`docker compose --profile runtime --profile media up -d legba-media`) and
# point this at the co-located service:
#     LEGBA_MEDIA_API_URL=http://legba-media:8800
# The legba-media service still 503s on each extraction kind until a real model
# backend is wired (legba-media/app/main.load_backends), so process_media stays
# honestly refusing until a model is provisioned. See legba-media/USAGE.md.
LEGBA_MEDIA_API_URL=
# Optional request timeout in seconds for the media endpoints (default 120).
LEGBA_MEDIA_API_TIMEOUT=120
# legba-media service knobs (only used when the `media` profile is up):
#   LEGBA_MEDIA_BACKENDS    — extraction kinds with a real backend wired
#                             (transcribe,caption,ocr,detect); empty = seam.
#   LEGBA_MEDIA_API_SECRET  — optional X-Models-Secret on the extraction
#                             endpoints (the runtime presents MODELS_API_PASS).
LEGBA_MEDIA_BACKENDS=
LEGBA_MEDIA_API_SECRET=

# --- B-2: fail-closed auth posture ---
# LEGBA_DEV_MODE=1 is the ONLY way to run the registry API without a bearer
# token (any/no token accepted, principal "anonymous"). With the token unset
# and this flag absent, every guarded HTTP/WS request gets 503. A configured
# LEGBA_REGISTRY_API_TOKEN is always enforced, dev flag or not. Never set in
# production.
LEGBA_DEV_MODE=
# A2A skill surface (runtime /a2a/skills) is UNMOUNTED by default. Set =1 to
# mount it — and then LEGBA_A2A_TRUSTED_KEYS must be non-empty (or
# LEGBA_DEV_MODE=1) or the runtime refuses to start.
LEGBA_A2A_ENABLED=
# Caller allowlist for the A2A surface: comma-separated did=hex pairs, where
# hex is the caller's 32-byte Ed25519 verify key.
# e.g. LEGBA_A2A_TRUSTED_KEYS=did:legba:peer1=0123...cdef,did:legba:peer2=89ab...0123
LEGBA_A2A_TRUSTED_KEYS=

# --- S-3: test-only live-probe gate (NOT a runtime key) ---
# Set =1 to let the env-gated live-probe tests (e.g.
# tests/data_pkg/test_source_json_api.py::test_live_probe_gdelt_doc_api) hit
# the real upstream API from the test container. Off by default; never needed
# in production.
LEGBA_LIVE_PROBES=

# --- B-3: repo hygiene scrub ---
# Operator contact email for geocoder User-Agent headers. The public OSM
# Nominatim usage policy requires an identifiable User-Agent including a
# way to reach the operator. Set a REAL, reachable address before enabling
# geocode filters against the public endpoint. The reserved `.invalid`
# placeholder below is treated as UNSET: the geocode handler then refuses
# to construct a public-Nominatim backend (fails loud at activation) until
# a real address, a self-hosted `nominatim_url`, or an explicit per-target
# `user_agent` is configured.
LEGBA_GEOCODER_CONTACT_EMAIL=ops@example.invalid
# Path to the instance Ed25519 signing key (A2A agent card + audit-chain
# checkpoints). Optional — features degrade gracefully when absent.
# LEGBA_SIGNING_KEY_PATH=/shared/keys/signing.key

# --- C-1: test-harness knobs (never set in production) ---
# Default predicate-DSL wall-clock budget override, in milliseconds. UNSET =
# the spec §3 production default (5 ms). The test suite sets this (via
# tests/conftest.py) so full-suite CPU contention can't trip the SIGALRM
# budget on a cold starlark eval; budget-enforcement tests pass explicit
# EvalBudget values and are unaffected.
LEGBA_PREDICATE_WALL_CLOCK_MS=
# Strict no-skip test mode: =1 escalates INFRA-GATED skips (Postgres/NATS/
# pivot-DB/daprd/Qdrant/Redis gates) to FAILURES. Opt-in, wired
# through scripts/run_tests_in_container.sh; the cutover flips the default.
LEGBA_TEST_STRICT=
