# Legba — Environment Configuration
# Copy to .env and fill in your values.
#
# ─── SOURCE OF TRUTH ────────────────────────────────────────────────────────
# At RUNTIME the registry is authoritative: the typed `stack_components` table
# (the StackRegistry — see src/legba/data/registry/stack.py) holds the live
# LLM / embedding / NLP / substrate endpoints, model names and credential refs.
# Configure/edit them through the registry API (`/api/v1/registry/stack`) or
# the in-app Settings panel — NOT by editing this file after bring-up.
#
# `.env` only does three things:
#   1. SEEDS those `stack_components` rows ONCE at bring-up, via
#      scripts/bringup_register_stack.py — the seed vars are:
#        LEGBA_LLM_API_ENDPOINT / LEGBA_LLM_MODEL_NAME   (→ llm_provider row)
#        LEGBA_EMBED_MODEL_NAME                          (→ embedding row)
#        LEGBA_NLP_API_ENDPOINT                          (→ nlp_service row)
#      Editing them later has NO effect on a running deployment — the registry
#      row already exists; change it via the API/Settings panel instead.
#   2. LOADS credentials into the vault ONCE at bring-up, via
#      scripts/bringup_vault_load.py (OPENAI_API_KEY, CONSULT_API_KEY,
#      MODELS_API_USER/PASS, source API keys, …). The registry only ever stores
#      vault REFERENCES, never plaintext.
#   3. Holds the few genuine long-term runtime vars the substrate needs before
#      the registry is reachable: the registry DSN + master encryption key
#      (LEGBA_DATA_REGISTRY_DSN / LEGBA_DATA_MASTER_KEY), live auth tokens
#      (LEGBA_REGISTRY_API_TOKEN, LEGBA_REGISTRY_SERVICE_TOKEN,
#      LEGBA_NATS_TOKEN, LEGBA_REDIS_PASSWORD,
#      perimeter basic-auth), and the live media endpoint (LEGBA_MEDIA_API_URL).
#
# Vars that were read by NOTHING were removed: OPENAI_BASE_URL, OPENAI_MODEL,
# CONSULT_MODEL, CONSULT_LLM_PROVIDER, MEMORY_EMBEDDING_MODEL,
# LLM_MAX_TOKENS / LLM_TEMPERATURE / LLM_TOP_P. The LLM/embedding model
# parameters (max_tokens, tier, dim, …) live in the registry component body.
# ─────────────────────────────────────────────────────────────────────────────

# --- Vault-loaded credentials (scripts/bringup_vault_load.py) ---
# Read once at bring-up and loaded into the credentials vault; descriptors
# reference them by vault path, never by env var.
# Primary LLM endpoint key (vault: llm.primary.api_key)
OPENAI_API_KEY=your-api-key-here
# Optional hosted consult route key (vault: llm.anthropic.api_key)
CONSULT_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# --- Model-serving endpoints (stack registry) ---
# The primary chat model and the embedding model are served out-of-process by
# an OpenAI-compatible endpoint; the baseline NLP service
# (translate/classify/extract/summarize) is a separate endpoint. These are read
# by scripts/bringup_register_stack.py at registration time. The values below
# are examples: set your own endpoints and the model names your server serves.
LEGBA_LLM_API_ENDPOINT=https://llm.example.internal
LEGBA_NLP_API_ENDPOINT=https://nlp.example.internal
LEGBA_LLM_MODEL_NAME=gpt-oss-120b
# Optional: the alias serving the same model with thinking on.
LEGBA_LLM_THINKING_MODEL_NAME=
# The primary model's own limits, as the endpoint states them (an
# OpenAI-compatible /v1/models listing usually carries them). Declared, the
# handler sends the alias's maximum output as max_tokens on every call and the
# input budgets follow the window; unset, no max_tokens is sent (the endpoint's
# default applies) and the input budget falls back. Never set these lower than
# the model's own figures: reasoning tokens count against the output maximum.
LEGBA_LLM_MAX_OUTPUT_TOKENS=
LEGBA_LLM_THINKING_MAX_OUTPUT_TOKENS=
LEGBA_LLM_CONTEXT_WINDOW_TOKENS=
LEGBA_EMBED_MODEL_NAME=bge-m3
# Optional model-gateway token. Read only by scripts/cutover_gateway.py, which
# registers it once as the vault secret `llm.gateway.api_key` (the gateway stack
# components reference that vault id, never this variable).
LEGBA_GATEWAY_API_TOKEN=
# --- Model gateway: address and model names (read at USE time) ---
# The gateway stack components in descriptors/ name these variables as
# "${env:NAME}" instead of carrying values; the registry stores the reference
# and the runtime and registry read the value from the environment each time
# they build the component. Required once such a component is registered: an
# unset or empty one fails loudly, naming the variable. A changed value takes
# effect when the services that use the component restart.
# The gateway base URL, including /v1 (also read by scripts/cutover_gateway.py).
LEGBA_GATEWAY_API_ENDPOINT=https://gateway.example.internal/v1
# Model the verify judge's first rung, the consult judge and the bearing gate call.
LEGBA_GATEWAY_JUDGE_MODEL=judge-model
# Model with thinking on for the verify judge's second rung.
LEGBA_GATEWAY_JUDGE_THINK_MODEL=judge-think-model
# Model with thinking on that drafts gold answers for grading runs.
LEGBA_GATEWAY_GOLD_DRAFTER_MODEL=judge-think-model
# Third-family model the external grader calls (distinct from writer and judge).
LEGBA_GATEWAY_GRADER_MODEL=grader-model
# Typed-choice decision model behind the gateway's /decide route.
LEGBA_GATEWAY_DECIDE_MODEL=decide-model
# Chat model the gateway NLP component translates with.
LEGBA_GATEWAY_TRANSLATE_MODEL=chat-model
# Each gateway alias's maximum output as the gateway states it (/v1/models
# `max_output_tokens`), sent as max_tokens on that component's calls, and the
# gateway's context window (`context_tokens`). The model's own figures, never
# smaller ones: a thinking alias's reasoning counts against its maximum.
LEGBA_GATEWAY_JUDGE_MAX_OUTPUT_TOKENS=32768
LEGBA_GATEWAY_JUDGE_THINK_MAX_OUTPUT_TOKENS=32768
LEGBA_GATEWAY_GOLD_DRAFTER_MAX_OUTPUT_TOKENS=32768
LEGBA_GATEWAY_GRADER_MAX_OUTPUT_TOKENS=32768
LEGBA_GATEWAY_CONTEXT_WINDOW_TOKENS=262144
MODELS_API_USER=your-nlp-basic-auth-user
MODELS_API_PASS=your-nlp-basic-auth-pass
# Optional defense-in-depth shared secret for legba-models. When set on the
# legba-models container (as LEGBA_MODELS_API_SECRET) every inference endpoint
# requires a matching X-Models-Secret header. Set the SAME value here so the
# runtime's nlp client presents it. Leave BLANK to disable (dev default).
MODELS_API_SECRET=
# Which nlp_service stack component the runtime binds. Unset/blank =
# nlp.local.legba_models. Read once at runtime start.
LEGBA_NLP_COMPONENT_ID=

# --- Faithfulness verify LLM judge ---
# The verify pass always runs the deterministic citation-presence floor. This
# flag also engages the LLM judge, which checks whether each cited clause
# follows from its evidence. It resolves through each analyst descriptor's
# ``method.llm.verify`` component (by default the same model as the writer).
# Off (the code default), the pass falls back to the floor, labelled
# ``judge-unavailable``; the floor checks that citations are present, not that
# they support the prose. This file sets it on.
LEGBA_VERIFY_LLM_JUDGE=1

# --- Composition verify floor ---
# Compositions (country/region/thematic/world) INNER-JOIN their input findings
# on LEAST(confidence, faithfulness) >= this floor — a finding below it is
# dropped from the composition slice; the slice names the gap. The code
# default is 0.50, the same bar the scorecard uses.
LEGBA_COMPOSITION_VERIFY_FLOOR=0.50

# --- Source API keys ---
# Loaded into the vault by scripts/bringup_vault_load.py and/or expanded
# into seeded source descriptors by scripts/seed_sources.py.
# NASA FIRMS
FIRMS_MAP_KEY=your-firms-map-key
# FRED (Federal Reserve Economic Data)
FRED_API_KEY=your-fred-key
# NVD (National Vulnerability Database)
NVD_API_KEY=your-nvd-key
# UN Comtrade
COMTRADE_PRIMARY_KEY=your-comtrade-key
# Event Registry / NewsAPI.ai
EVENT_REGISTRY_API_KEY=your-event-registry-key
# AlienVault OTX (optional)
# OTX_API_KEY=your-otx-key

# --- Keyed source descriptors ---
# Plaintexts for the vault refs declared in descriptors/source_*.yaml
# (acled / gdelt_bigquery / mediacloud / opensanctions_api / telegram).
# Placeholders only — set real values, then promote into the credential
# vault with scripts/bringup_vault_load.py. The descriptors ship state:
# draft and only activate after an admin stores these and activates them
# (see each descriptor's header for the exact steps).
# ACLED access key → vault id source.acled.api_key (mapped from ACLED_API_KEY
# by bringup_vault_load.py). The registration email is NOT a secret — set it
# in descriptors/source_acled_conflict.yaml config.email. ACLED_EMAIL is only
# a note of which address that key belongs to.
ACLED_EMAIL=
ACLED_API_KEY=
# GDELT: the GCP service-account JSON for BigQuery, as a single line
# (vault id: source.gdelt.bigquery_sa).
GDELT_BQ_SERVICE_ACCOUNT_JSON=
# MediaCloud API key (vault id: source.mediacloud.api_key).
MEDIACLOUD_API_KEY=
# OpenSanctions API key — api mode only; the bulk_csv descriptor is keyless
# (vault id: source.opensanctions.api_key).
OPENSANCTIONS_API_KEY=
# Telegram MTProto credentials from https://my.telegram.org plus a base64
# Telethon session blob generated out-of-band via telethon_auth.py
# (vault ids: source.telegram.api_id / .api_hash / .session).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_B64=

# --- legba.data package bootstrap ---
# The registry connection, the master encryption key and the default stack
# ids are the long-term env vars; everything else comes from the stack
# registry.

# Substrate store endpoints (LEGBA_DATA_* prefix; falls back to legacy names).
# Inside docker: use service names (postgres, qdrant, etc.). On host: use 127.0.0.1.
LEGBA_DATA_PG_HOST=postgres
LEGBA_DATA_PG_PORT=5432
LEGBA_DATA_PG_USER=legba
LEGBA_DATA_PG_PASSWORD=legba
LEGBA_DATA_PG_DB=legba
LEGBA_DATA_PG_POOL_MIN=1
LEGBA_DATA_PG_POOL_MAX=10

LEGBA_DATA_QDRANT_HOST=qdrant
LEGBA_DATA_QDRANT_PORT=6333
LEGBA_DATA_QDRANT_GRPC_PORT=6334

LEGBA_DATA_REDIS_HOST=redis
LEGBA_DATA_REDIS_PORT=6379
LEGBA_DATA_REDIS_DB=0
LEGBA_DATA_REDIS_MAXMEMORY_POLICY=allkeys-lru
LEGBA_DATA_REDIS_EMBED_TTL=86400

LEGBA_DATA_NATS_URL=nats://nats:4222

# Embedding model name and vector size (example values).
LEGBA_DATA_EMBED_MODEL=BAAI/bge-m3
LEGBA_DATA_EMBED_DIM=1024

# Registry bootstrap.
LEGBA_DATA_REGISTRY_DSN=postgresql://legba:legba@postgres:5432/legba
LEGBA_DATA_MASTER_KEY=replace-with-base64-32-bytes
LEGBA_DATA_DEFAULT_PG=pg.cluster_main
LEGBA_DATA_DEFAULT_REDIS=kv.redis.cluster_main
LEGBA_DATA_DEFAULT_NATS=bus.nats.cluster_main
LEGBA_DATA_DEFAULT_VECTOR=vector.qdrant.cluster_main
LEGBA_DATA_DEFAULT_EMBEDDING=embed.primary.openai_compat
LEGBA_DATA_DEFAULT_LLM=

# --- Dapr actor state store ---
# Full Postgres DSN for Dapr's actor state store, resolved by the daprd
# sidecar's local.env secret store (dapr/components/secretstore.yaml) and
# referenced from dapr/components/statestore.yaml via secretKeyRef — so no
# password is committed in the component YAML. Targets the DEDICATED `dapr`
# database (created by the dapr-init-db one-shot), NOT the substrate `legba`
# DB, to keep actor-state churn off the substrate.
LEGBA_DAPR_PG_CONNSTRING=host=postgres user=legba password=legba dbname=dapr sslmode=disable

# --- Drain the actor host at SIGTERM (runtime/shutdown_drain.py) ---
# Seconds (1-60) the runtime keeps its in-flight actor turns after SIGTERM before
# it stops — an analyst run whose finding is written but whose verify critique is
# not yet. Unset/0 = stop at the first signal (the old behaviour). Read by the
# process at start, so it takes effect from the deploy after it is set; deploy
# with `scripts/rolling_deploy.sh --drain-seconds N`, N >= this + 10.
# LEGBA_RUNTIME_DRAIN_SECONDS=45

# --- Substrate auth ---
# All substrate host ports bind 127.0.0.1 (only Caddy 80/443 is public);
# these two keys add in-cluster auth on top. Empty = unauthenticated. Generate:
#   openssl rand -hex 32
# LEGBA_NATS_TOKEN: nats-server --auth token; threaded to every NATS client
# (NatsConfig/NatsStore, registry health probes, dapr pubsub.yaml via the
# local.env secret store).
LEGBA_NATS_TOKEN=
# LEGBA_REDIS_PASSWORD: redis --requirepass; threaded to every redis client
# (RedisConfig/RedisStore, registry health probes, compose healthcheck).
LEGBA_REDIS_PASSWORD=

# --- Caddy perimeter auth (public surface) ---
# Public site domain Caddy serves + auto-obtains a Let's Encrypt cert for
# (docker/Caddyfile reads it as {$LEGBA_PUBLIC_DOMAIN:localhost}). Set your real
# domain; unset falls back to `localhost` with Caddy's internal CA (local dev).
LEGBA_PUBLIC_DOMAIN=legba.example.com
# The registry knows two principals and stamps which one wrote every audit row
# (`operator:bearer:<hash>` / `service:bearer:<hash>`). With both tokens unset
# every guarded request gets HTTP 503 unless LEGBA_DEV_MODE=1 (below) is set.
#
# LEGBA_REGISTRY_API_TOKEN — the admin bearer: your curl, the by-hand
# tools, the vault loaders, and the UI perimeter (caddy injects it upstream
# after basic_auth). Set to a 32-byte hex (openssl rand -hex 32).
LEGBA_REGISTRY_API_TOKEN=
# LEGBA_REGISTRY_SERVICE_TOKEN — the services' bearer: the runtime (actors,
# scheduler, watchdogs, resync), the Dapr workflow worker and the bring-up
# registrars deploy.sh runs. A SECOND, DISTINCT 32-byte hex
# (openssl rand -hex 32). The registry REFUSES it on the human-only routes
# (the vault; descriptor transition/retire/promote/rollback by hand).
# Unset = the services fall back to the admin token, logged as
# `principal_fallback` and counted — it keeps working, but its writes are
# labelled operator:. Set it on the registry AND the runtime (both read .env).
LEGBA_REGISTRY_SERVICE_TOKEN=
#
# Sign-in — docs/OPERATING_YOUR_INSTANCE.md section 9. 1 = people sign
# in with accounts (create the owner first: docker compose exec legba-registry
# python -m legba.data.users_bootstrap), three roles, a token per service, and the edge
# stops handing browsers the admin token; unset / 0 = off (the default).
# Only 0 or 1: caddy refuses to start on any other value.
LEGBA_AUTH_SIGNIN=0
# Idle limit of a sign-in session, in hours (default 12; switch on only).
# LEGBA_SESSION_IDLE_HOURS=12
# One credential per service, read only with LEGBA_AUTH_SIGNIN=1. Each a
# distinct random value (openssl rand -hex 32); the registry holds all of
# them, each service presents its own and is recorded as service:<name>.
# Unset = that service falls back to LEGBA_REGISTRY_SERVICE_TOKEN (logged).
LEGBA_SERVICE_TOKEN_REGISTRY=
LEGBA_SERVICE_TOKEN_RUNTIME=
LEGBA_SERVICE_TOKEN_WORKER=
# The console's server side; the stock edge forwards the person's session
# and needs none.
LEGBA_SERVICE_TOKEN_CONSOLE=
# Ed25519 signing key (hex) for the registry's receipt/audit chains. UNSET =
# the registry boots with an EPHEMERAL in-memory key (logged at WARNING), so
# receipt-chain continuity BREAKS across every restart (a new key each boot).
# Set a STABLE 32-byte (64 hex char) seed for any non-throwaway instance:
#   openssl rand -hex 32
# Or point at a 32-raw-byte keyfile instead:
#   LEGBA_REGISTRY_SIGNING_KEY_FILE=/shared/keys/registry-signing.key
LEGBA_REGISTRY_SIGNING_KEY=
# LEGBA_REGISTRY_SIGNING_KEY_FILE=
# Caddy perimeter basic_auth bcrypt hash for user `legba` (NOT committed to the
# repo — read by docker/Caddyfile via {$LEGBA_BASIC_AUTH_HASH}). Generate with:
#   caddy hash-password --plaintext '<password>'
# IMPORTANT: single-quote the value — a bcrypt hash contains '$' which
# docker compose env_file otherwise interpolates away (mangles the hash →
# basic_auth silently rejects every password). e.g. LEGBA_BASIC_AUTH_HASH='$2a$14$...'
LEGBA_BASIC_AUTH_HASH=

# Console perimeter (docker/Caddyfile). 1 (default): the console sits behind the
# basic_auth password above. 0: no perimeter password, the registry's sign-in
# is the only gate. 0 is accepted ONLY with LEGBA_AUTH_SIGNIN=1; the edge
# refuses to start on 0 with sign-in off. The ntfy vhost keeps the password.
# LEGBA_EDGE_PERIMETER=1

# --- Media-extraction endpoint ---
# Base URL of the hosted media service (/transcribe /caption /ocr /detect).
# UNSET = the path is a declared seam that fails loud: process_media enqueue
# and execution REFUSE (typed error, no row written) and media:"eager"
# sources refuse activation. No stub transcript/caption ever lands in the
# shared signal pool. Auth reuses MODELS_API_USER / MODELS_API_PASS.
#
# To deploy and test the loop in-stack, bring up the `media` profile
# (`docker compose --profile runtime --profile media up -d legba-media`) and
# point this at the co-located service:
#     LEGBA_MEDIA_API_URL=http://legba-media:8800
# The legba-media service still 503s on each extraction kind until a real model
# backend is wired (legba-media/app/main.load_backends), so process_media keeps
# refusing until a model is provisioned. See legba-media/USAGE.md.
LEGBA_MEDIA_API_URL=
# Optional request timeout in seconds for the media endpoints (default 120).
LEGBA_MEDIA_API_TIMEOUT=120

# --- Cited-evidence archive (evidence_archiver) ---
# In-container root of the content-addressed evidence archive. The compose
# file mounts the `legba_archive` named volume here and defaults the env, so
# this normally stays unset. Objects land at {root}/{sha256[:2]}/{sha256};
# signals.object_ref records the relative address cas:sha256/<hex> — the root
# can move (or become an object store) without rewriting rows. Archived
# objects are EVIDENCE: nothing auto-deletes a CITED one. The one exception is
# the archive_retention sweep (off by default): set LEGBA_ARCHIVE_RETENTION=1 to
# let it remove the stored bytes of rows no finding/fact/event cites that are
# older than its retention_days (default 45); the row is kept as
# status='expired_uncited'. It also needs its descriptor registered and active.
#LEGBA_ARCHIVE_ROOT=/var/lib/legba/archive
#LEGBA_ARCHIVE_RETENTION=0

# Trace compaction (off by default). When on, the daily analyst_traces_retention
# run packs the prompt, input and output of runs older than AFTER_DAYS into
# xz bundles of BUNDLE_SIZE runs of one analyst (analyst_trace_bundles), checks
# each bundle reads back byte for byte, then empties those three columns on the
# trace rows. Nothing is deleted; every reader reads a compacted trace as
# before. Each run stops after MAX_SECONDS and the next one resumes. AFTER_DAYS
# is never below 14.
#LEGBA_TRACE_COMPRESS=0
#LEGBA_TRACE_COMPRESS_AFTER_DAYS=30
#LEGBA_TRACE_COMPRESS_BUNDLE_SIZE=32
#LEGBA_TRACE_COMPRESS_MAX_SECONDS=300

# --- Backup (scripts/backup.sh, backup_scheduled.sh, restore_drill.sh) ---
# Every artifact is encrypted to an OpenPGP PUBLIC key before it is written;
# backup.sh REFUSES to run without one. Keep the matching SECRET key OFF this
# host (the restore drill and a real restore need it). Make a pair elsewhere:
#   gpg --quick-gen-key 'legba-backup' ed25519 default never   # then --export -a
# The escrow artifact (.env with the vault master key + the signing key) may
# go to a second key; unset = the backup key.
LEGBA_BACKUP_PUBKEY=/etc/legba/backup-pubkey.asc
#LEGBA_BACKUP_ESCROW_PUBKEY=/etc/legba/escrow-pubkey.asc
# Where sets go: a local path (the default — NOT disaster-proof on its own),
# ssh://user@host[:port]/path or user@host:/path (rsync), rclone:<remote>:<path>,
# or s3://bucket/path (rclone remote LEGBA_BACKUP_RCLONE_REMOTE, default "s3").
LEGBA_BACKUP_DEST=/var/backups/legba
#LEGBA_BACKUP_STAGING=/var/backups/legba/staging
# Archive index + last_backup.json / last_drill.json (the registry mounts this
# directory read-only for GET /v3/system/backup-status).
#LEGBA_BACKUP_STATE_DIR=/var/lib/legba/backup-state
# Retention: newest set per day for 7 days + per ISO week for 4 weeks. The
# archive pack chain is never pruned.
#LEGBA_BACKUP_KEEP_DAILY=7
#LEGBA_BACKUP_KEEP_WEEKLY=4
# Refuse/abort above this fill of the set's filesystem (OpenSearch's flood
# stage on a shared disk is 95%).
#LEGBA_BACKUP_MAX_DISK_PCT=90
# legba-media service knobs (only used when the `media` profile is up):
#   LEGBA_MEDIA_BACKENDS    — extraction kinds with a real backend wired
#                             (transcribe,caption,ocr,detect); empty = seam.
#   LEGBA_MEDIA_API_SECRET  — optional X-Models-Secret on the extraction
#                             endpoints (the runtime presents MODELS_API_PASS).
LEGBA_MEDIA_BACKENDS=
LEGBA_MEDIA_API_SECRET=

# --- Fail-closed auth ---
# LEGBA_DEV_MODE=1 is the ONLY way to run the registry API without a bearer
# token (any/no token accepted, principal "anonymous"). With the token unset
# and this flag absent, every guarded HTTP/WS request gets 503. A configured
# LEGBA_REGISTRY_API_TOKEN or LEGBA_REGISTRY_SERVICE_TOKEN is always enforced,
# dev flag or not. Never set in production.
LEGBA_DEV_MODE=
# A2A skill surface (runtime /a2a/skills) is UNMOUNTED by default. Set =1 to
# mount it — and then LEGBA_A2A_TRUSTED_KEYS must be non-empty (or
# LEGBA_DEV_MODE=1) or the runtime refuses to start.
LEGBA_A2A_ENABLED=
# Caller allowlist for the A2A surface: comma-separated did=hex pairs, where
# hex is the caller's 32-byte Ed25519 verify key.
# e.g. LEGBA_A2A_TRUSTED_KEYS=did:legba:peer1=0123...cdef,did:legba:peer2=89ab...0123
LEGBA_A2A_TRUSTED_KEYS=

# --- Outward alert sinks ---
# Generic webhook alert sink: HTTP POST of the converged alert payload
# (summary / severity / verify state / source links / lineage receipt link)
# for alerts that clear the escalation gate + the global pipeline-stall
# watchdog alert. UNSET = the sink is declared-inactive: it logs the gap
# once at boot and every fan-out records an alert_sink_deliveries row with
# status=skipped_unconfigured (visible, never a silent drop). The URL is
# host-redacted in all logs + ledger rows (webhook URLs embed secrets).
LEGBA_ALERT_WEBHOOK_URL=
# Severity floor for the webhook sink (info|low|medium|high|critical).
# Default: high.
LEGBA_ALERT_WEBHOOK_MIN_SEVERITY=
# ntfy alert sink: native ntfy publish — plaintext message body plus
# X-Title / X-Priority / X-Tags / X-Click headers, human-readable on a phone
# (tapping the notification opens the lineage receipt when
# LEGBA_PUBLIC_BASE_URL is set). Value = the FULL topic URL, e.g.
# http://ntfy/legba-alerts (in-network) or http://127.0.0.1:8093/legba-alerts.
# UNSET = declared-inactive: same visible skipped_unconfigured ledger contract
# as the webhook sink. The topic path is host-redacted in all logs + ledger
# rows (a topic name is effectively a secret).
LEGBA_ALERT_NTFY_URL=
# Optional access token for a protected ntfy server (sent as
# Authorization: Bearer). Never logged.
LEGBA_ALERT_NTFY_TOKEN=
# Severity floor for the ntfy sink (info|low|medium|high|critical).
# Default: high (mirrors the webhook sink).
LEGBA_ALERT_NTFY_MIN_SEVERITY=
# Alert topics: two topics on the server LEGBA_ALERT_NTFY_URL names (its last
# path segment, the pre-split topic, is dropped): `world` (escalation
# transitions, verified high findings, band moves batched one push per tick)
# and `engine` (source/search/cadence/judge health). Subscribe the ntfy web UI
# to both (and keep `nightly`). Names overridable; SPLIT=0 restores the single
# pre-split topic. docs/TUNABLES.md §5 has the topic table.
LEGBA_ALERT_NTFY_TOPIC_WORLD=
LEGBA_ALERT_NTFY_TOPIC_ENGINE=
LEGBA_ALERT_NTFY_TOPIC_SPLIT=
# An escalation whose severity held from the unit's previous read is recorded,
# never pushed (1, default). 0 pushes levels again.
LEGBA_ALERT_SUPPRESS_LEVEL_ONLY=
# Band moves listed per batched push (default 8), and the per-topic 24 h push
# caps above which the watchdog pages alert_volume_high (default 50 each).
LEGBA_ALERT_BAND_BATCH_MAX_LINES=
LEGBA_ALERT_VOLUME_DAILY_CAP_WORLD=
LEGBA_ALERT_VOLUME_DAILY_CAP_ENGINE=
# Optional absolute base for outward receipt links (e.g.
# https://legba.example.org). Unset = payloads carry only the relative
# /api/v1/lineage/... path.
LEGBA_PUBLIC_BASE_URL=

# --- Test-only live-probe gate (not a runtime key) ---
# Set =1 to let the env-gated live-probe tests (e.g.
# tests/data_pkg/test_source_json_api.py::test_live_probe_gdelt_doc_api) hit
# the real upstream API from the test container. Off by default; never needed
# in production.
LEGBA_LIVE_PROBES=

# --- Geocoder contact ---
# Contact email for geocoder User-Agent headers. The public OSM
# Nominatim usage policy requires an identifiable User-Agent including a
# way to reach whoever runs the instance. Set a REAL, reachable address before enabling
# geocode filters against the public endpoint. The reserved `.invalid`
# placeholder below is treated as UNSET: the geocode handler then refuses
# to construct a public-Nominatim backend (fails loud at activation) until
# a real address, a self-hosted `nominatim_url`, or an explicit per-target
# `user_agent` is configured.
LEGBA_GEOCODER_CONTACT_EMAIL=ops@example.invalid
# Path to the instance Ed25519 signing key (A2A agent card + audit-chain
# checkpoints). Optional — features degrade gracefully when absent.
# LEGBA_SIGNING_KEY_PATH=/shared/keys/signing.key

# --- External retrieval (web search) ---
# Search ships INERT. The compose `search` profile can be up and the
# `search.searxng.local` stack component registered, and NO analyst behaviour
# changes, because retrieval additionally needs (a) a provider pointed at the
# engine and (b) the three-way agency gate (an analyst granting `web_access`
# AND a target allowing it). Both knobs below are OFF by default on purpose.
#
# REQUIRED FIRST, and easy to miss: the runtime's SSRF egress guard refuses
# RFC-1918 targets, and `searxng` resolves to one over the compose network. Add
# the single exact hostname — never a subnet or wildcard:
#     LEGBA_EGRESS_ALLOW_HOSTS=rsshub,searxng
# Without it every query fails with `egress_blocked`, which is the right
# failure: loud, not silent.
#
# The legacy pinned endpoint. Setting this alone makes `web_search`
# work with no other change — the searxng handler already speaks the
# `/search?format=json` field names. UNSET = web_search returns a clean failure
# naming the gap; it never returns a silent empty result.
# LEGBA_WEB_SEARCH_ENDPOINT=http://searxng:8080/search
#
# Global repoint onto a registered `search_provider` component. It
# REPOINTS an already-opted-in route; it can never ENABLE search on a
# descriptor that did not ask for it.
LEGBA_SEARCH_STACK_REF=
#
# Registrar override for the endpoint written into `search.searxng.local` by
# scripts/bringup_register_stack.py. UNSET = http://searxng:8080/search.
# LEGBA_SEARXNG_ENDPOINT=
#
# Control-probe freshness, in seconds. An empty search result is SUSPECT by
# default — over a multi-engine meta-search a genuinely empty result set is
# close to impossible, so it usually means BROKEN. A zero-result response with
# no admitted degradation therefore triggers ONE bounded control probe (a fixed
# high-yield query) to decide whether the engine set is answering at all; only a
# liveness-verified empty may be reported as a (scoped) absence. The verdict is
# cached per provider for this long, so a run with several empty searches costs
# ONE probe, not N. UNSET = 300s. A zero or non-numeric value is IGNORED (it
# would burn one upstream query per empty result, which is exactly the ban
# pressure the cache prevents). This is also the control-query canary — there is
# no second one.
# LEGBA_SEARCH_CONTROL_PROBE_TTL_SECONDS=300
#
# --- Paid rung of the search provider ladder (Brave) ---
# SearXNG stays rung 0. Brave is the rung the ladder falls to when
# rung 0 DEGRADES — a first-party index, so it does not share SearXNG's
# upstream-ban surface. Setting this key alone activates NOTHING: the component
# ships `state: draft` and the ladder is empty until an admin also adds
# `fallback_providers` to the web_access pack's web_search ToolSpec. See
# descriptors/stack_component_search_brave.yaml for the four-step flip.
#
# Promoted into the vault as `search.brave.api_key` by
# scripts/bringup_vault_load.py. UNSET = the component (if registered) refuses
# every query with SearchProviderUnresolved saying NO query was issued, and its
# healthcheck reports UNHEALTHY. It never returns a silent empty result set —
# "we have no key" and "the web has nothing" must not share a wire shape.
#
# NO LEGBA_EGRESS_ALLOW_HOSTS entry is needed for api.search.brave.com. That
# allowlist permits RFC-1918 compose sidecars the SSRF guard would otherwise
# refuse; a public host is already allowed. The credential fence is in the
# handler instead (allowed_endpoint_hosts), so the paid token can only ever be
# sent to Brave's own API host.
#
# ⚠ Arming the paid rung ALSO requires a spend ceiling: the ladder REFUSES a
# metered rung when the web_access pack declares no
# `governor.max_cost_usd_per_day`. An unenforced spend cap on a metered
# external API would be unbounded.
# LEGBA_BRAVE_SEARCH_API_KEY=

# --- The reference builder (reference_builder) ---
# UNSET/off = the analyst does nothing at all: no search, no fetch, no model
# call, no row. The descriptor also ships `state: draft`, so this flag and an
# admin PUT are both required before a reference lands. Values that turn it on:
# 1/true/yes/on. It uses the core model only.
LEGBA_REFERENCE_BUILDER_ENABLED=
# Extra hosts ADDED to the Tier 1-2 discovery allowlist (comma-separated, never
# replacing the built-in set). For a regional paper of record the shipped list
# does not know. Leave unset unless you have a specific outlet in mind: an
# unrecognised host is Tier 3 by design, which is the fail-safe direction.
LEGBA_REFERENCE_TIER12_HOSTS=

# --- The composition correctness gate (country_composition) ---
# UNSET/off = country_composition is byte-identical to a tree without the gate:
# no query, no row marked, no payload key. Values that turn it on: 1/true/yes/on.
# ON, a desk unit is COMPOSED over only if its latest `unit_correctness` row
# exists, is not single-family (unless the flag below says otherwise), and
# clears BOTH bars. A unit that fails is QUOTED — demoted into the periphery
# tier, still visible and still cited, never dropped.
LEGBA_COMPOSITION_CORRECTNESS_GATE=
# The two bars, both required, both [0,1]. They are env and not descriptor
# options on purpose: a bar deciding what the platform is willing to ASSERT
# should move at a deploy step, not by a registry PUT. An unparseable value
# logs and falls back to the default, never to "no bar". Coverage is required
# because a unit that decides few claims can score high on correctness alone.
LEGBA_COMPOSITION_GATE_MIN_CORRECTNESS=
LEGBA_COMPOSITION_GATE_MIN_COVERAGE=
# Whether a number ONE grader family produced may carry a composition.
# Read this before switching the gate on: with no second grader family
# configured, every number is single-family and a gate with this unset
# composes over nothing. Configure a second family or set this deliberately.
LEGBA_COMPOSITION_GATE_ALLOW_SINGLE_FAMILY=

# --- The attention instrument (desk_reference) ---
# UNSET/off = the analyst does not run: no reference row, no external search,
# no out-of-plane LLM call, no watermark, no gauge. The descriptor also ships
# `state: draft`, so this flag and an admin PUT are both required before a
# row lands. Values that turn it on: 1/true/yes/on.
LEGBA_DESK_REFERENCE_ENABLED=
# The reference-gap dispatch, gated separately and default off so the
# instrument can be measured for a while before it is allowed to create work.
# On, each UNCOLLECTED material reference item side-writes (a) a
# `collection_requirements` row with `origin='reference_gap'` — the third
# origin, beside collection_gap and source_request, read by the research
# program's dispatcher through the same door — and (b) an `open_question`
# hypothesis with `harvest_class='reference_gap'` for the corpus_researcher's
# backlog. Both are idempotent (natural_key / a containment probe over OPEN
# questions), both degrade-not-break, and neither can fail the desk_reference
# sweep. Leg (b) is ADDITIONALLY gated on LEGBA_RESEARCH_EVIDENCE: dispatching
# into a backlog whose researcher has no web leg is a question nothing can
# answer. Off, the sweep's finding payload carries
# `data.reference_gap_dispatch = {"enabled": false}`.
LEGBA_REFERENCE_GAP_DISPATCH_ENABLED=

# --- Consult watches and the scheduled desks' grounding ---
# A consult answer's watch candidates are minted as open questions that
# claim_watch watches. UNSET/off = those `created_by='consult'` rows are
# EXCLUDED from the scheduled units' STANDING OPEN QUESTIONS grounding block
# (unit_grounding.read_desk_open_questions) and from the corpus researcher's
# open-question backlog (grounding.resolve_open_questions), so an ad-hoc
# question does not steer the desks' reads, and the backlog drain cannot
# claim a watch out of claim_watch's open set. claim_watch watches them either
# way. On (1/true/yes/on) = they are included.
LEGBA_DESK_GROUNDING_INCLUDES_CONSULT_WATCHES=

# --- Test-harness knobs (never set in production) ---
# Default predicate-DSL wall-clock budget override, in milliseconds. UNSET =
# the spec §3 production default (5 ms). The test suite sets this (via
# tests/conftest.py) so full-suite CPU contention can't trip the SIGALRM
# budget on a cold starlark eval; budget-enforcement tests pass explicit
# EvalBudget values and are unaffected.
LEGBA_PREDICATE_WALL_CLOCK_MS=
# Strict no-skip test mode: =1 escalates INFRA-GATED skips (Postgres/NATS/
# pivot-DB/daprd/Qdrant/Redis gates) to FAILURES. Opt-in, wired
# through scripts/run_tests_in_container.sh.
LEGBA_TEST_STRICT=

# --- Optional judge-route + source credentials (vault-mapped by ---
# scripts/bringup_vault_load.py; UNSET = the loader reports them absent and
# every consumer degrades — no route/source is required to run the core).
# Cross-family judge candidates (opt-in via LEGBA_JUDGE_STACK_REF):
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# ACLED portal credentials (source stays inert without them):
ACLED_USERNAME=
ACLED_PASSWORD=

# The OpenAI-compatible handler sends each alias's declared maximum output
# (the stack component's max_output_tokens / thinking_max_output_tokens) as
# max_tokens, less only when the counted input leaves less room in the
# declared window; an alias with no declared maximum gets none. A call's own
# max_tokens (a descriptor's method.llm.max_tokens) is never sent on any
# route. =0 (or false/no/off) turns sending off deployment-wide; any other
# value, or unset, leaves it on.
LEGBA_LLM_SEND_MAX_TOKENS=

# Explicit input-token budget (estimated tokens, chars/4) for the evidence a
# model call carries: the unit slice, a GATHER run's evidence cap, the
# composition block, and a consult's derived context ceiling. UNSET (the
# recommended setting) derives it from the route's declared context window:
# the window less room for its largest maximum output (at most half the
# window) less 4,096. Set it only to override that.
LEGBA_LLM_INPUT_TOKEN_BUDGET=

# Liveness watchdog: the OLD per-source cadence check (alert channel
# source_cadence_stall). Default ON. =0/false/off/no skips it entirely — set
# once the source staleness tripwire (source_staleness_*) has run long
# enough to replace it. Read at runtime start (recreate to change).
LEGBA_SOURCE_CADENCE_STALL_CHECK=1
