# IDE / tools
.claude/
.vscode/
.idea/

# Working/planning docs archive
docs/archive/
docs/feedback/

# Local signing key and bearer token
.legba_signing_key
.legba_bearer_token

# UI v4 self-hosted basemap (large; provided by the deployer)
deploy/tiles/*.pmtiles

# Generated screenshot OUTPUT from the dev render harness (the harness source is tracked)
legba-ui-v3/tools/screenshot/shots/

# Private working notes — not part of the release.
planning/

# Operational research corpus — local only.
# Corpus DATA lives on the deploying host only: never tracked, never pushed, never
# seeded with the project, never baked into images. The loader CODE ships
# in-repo (src/legba/data/seed/... + scripts/); the DATA does not. Per-chunk
# license/provenance metadata is still recorded (hygiene + future options).
corpora/

# Curated seed DATA — not part of the public project. The seed MACHINERY (src/legba/data/seed/**, scripts/seed*.py,
# the adapters) ships; the DATA does not. Provide your own — see seeds/README.md.
seeds/*.yaml
!seeds/*.example.yaml
scripts/backfill/seed_data.sql
scripts/seed_data.py

# External-agent worktrees (docs/V3_IMPLEMENTATION_PLAN.md §0) — never tracked
.worktrees/
# C-1: the cold-tier object store credentials (deploy/patches/seaweedfs-coldstore.patch)
deploy/seaweedfs/
