--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -816,6 +816,50 @@
   # browser/UI test. Message cache is in-container ephemeral (a restart drops
   # history; deliveries stay durably audited in alert_sink_deliveries — the
   # ledger is the record, ntfy is the pipe).
+  # Evidence-archive COLD tier: a small internal S3-compatible store.
+  # Off unless `--profile coldstore`. Proven end to end on real bytes
+  # (docs/operations/archive-tiering.md). The runtime reaches it as
+  # http://seaweedfs:8333 on the compose network; the host only on loopback.
+  # Credentials: deploy/seaweedfs/s3.json (gitignored, mode 600, generated by
+  # the operator — never committed); the same key pair goes into .env as
+  # LEGBA_ARCHIVE_S3_ACCESS_KEY_ID / LEGBA_ARCHIVE_S3_SECRET_ACCESS_KEY, with
+  # LEGBA_ARCHIVE_COLD_BACKEND=s3, LEGBA_ARCHIVE_S3_ENDPOINT=http://seaweedfs:8333,
+  # LEGBA_ARCHIVE_S3_BUCKET=legba-archive. The bucket is created once by hand.
+  # Measured: idle ~25 MiB RAM and ~1 MB of disk before data; OOM-killed at
+  # 512m under sustained ranged reads, hence 1g plus GOMEMLIMIT. volumePreallocate=false:
+  # with the default each new volume reserved its full size (7.2 GB for 2.2 GB).
+  # Ports: loopback only; the S3 API is the only one published.
+  seaweedfs:
+    logging: *default-logging
+    image: chrislusf/seaweedfs:3.80@sha256:1055999e08eed1789b0ae45d235126e4495e23d3fb9d6396293fd42539b1ae6a
+    profiles: ["coldstore"]
+    hostname: seaweedfs
+    command:
+      - server
+      - -ip=seaweedfs
+      - -ip.bind=0.0.0.0
+      - -dir=/data
+      - -master.volumeSizeLimitMB=1024
+      - -master.volumePreallocate=false
+      - -volume.max=0
+      - -volume.index=leveldb
+      - -s3
+      - -s3.port=8333
+      - -s3.config=/etc/seaweedfs/s3.json
+    environment:
+      # Go heap ceiling below the container limit: without it 3.80 grew to the
+      # limit under sustained ranged reads; with 640MiB it held ~590 MiB.
+      GOMEMLIMIT: 640MiB
+    mem_limit: 1g
+    volumes:
+      - coldstore_data:/data
+      - ./deploy/seaweedfs/s3.json:/etc/seaweedfs/s3.json:ro
+    ports:
+      - "127.0.0.1:8333:8333"
+    networks:
+      - default
+    restart: unless-stopped
+
   ntfy:
     logging: *default-logging
     image: binwiederhier/ntfy:latest
@@ -979,3 +1023,7 @@
   # never auto-deleted; plain-FS first, MinIO/SeaweedFS is the later seam.
   archive_data:
     name: legba_archive
+  # Evidence-archive cold tier store (profile coldstore). Holds
+  # retired bundles: never pruned by hand — a bundle is evidence.
+  coldstore_data:
+    name: legba_coldstore
