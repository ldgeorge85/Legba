# Legba scheduled backup (resilience-observability W-1b §5).
#
# Oneshot unit run by legba-backup.timer. Wraps scripts/backup.sh with
# retention + offsite (scripts/backup_scheduled.sh). Install:
#
#   sudo cp deploy/systemd/legba-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now legba-backup.timer
#   systemctl list-timers legba-backup.timer        # confirm next run
#   sudo systemctl start legba-backup.service        # run once now
#
# Offsite is OFF until LEGBA_BACKUP_OFFSITE_DEST is set (in .env). Until then
# the wrapper warns loudly + drops an OFFSITE_NOT_CONFIGURED marker (declared
# SEAM — see docs/SEAMS.md). See docs/RUNBOOK.md backup section for the restore
# drill.

[Unit]
Description=Legba scheduled backup (pg + redis + qdrant + NATS JetStream, retention + offsite)
Documentation=file:///usr/local/deployments/active/legba/docs/RUNBOOK.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/usr/local/deployments/active/legba
EnvironmentFile=-/usr/local/deployments/active/legba/.env
# Substrate ports are loopback-mapped from the compose stack.
Environment=PG_HOST=127.0.0.1
Environment=PG_PORT=5432
Environment=REDIS_HOST=127.0.0.1
Environment=REDIS_PORT=6379
Environment=QDRANT_URL=http://127.0.0.1:6333
Environment=OS_URL=http://127.0.0.1:9200
Environment=OS_AUDIT_URL=http://127.0.0.1:9201
Environment=NATS_URL=nats://127.0.0.1:4222
Environment=COMPOSE_PROJECT=legba
Environment=LEGBA_BACKUP_KEEP=14
ExecStart=/usr/bin/env bash /usr/local/deployments/active/legba/scripts/backup_scheduled.sh
StandardOutput=append:/usr/local/deployments/active/legba/logs/backup.log
StandardError=append:/usr/local/deployments/active/legba/logs/backup.log
