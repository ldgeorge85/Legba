# legba-models — required env for deployment on a GPU host
#
# Copy to `.env` on the deploy host. `.env` is gitignored.
# This service deploys ON the GPU host, not on the legba application host.
# Caddy fronts it at `models.<host>` and lives in a shared caddy deployment
# on the same host (not inside this directory).

# Hugging Face token for downloading model weights at first start. Get one
# at https://huggingface.co/settings/tokens — needs read access to gated
# model repos used here (NLLB-200, DeBERTa-v3, GLiREL, T5).
HUGGING_FACE_HUB_TOKEN=

# Which GPU device to bind the SLM-overlay variant to. The base
# docker-compose.yml hard-codes GPU 0 for the four small models; the
# SLM-overlay (docker-compose.slm.yml) pins the larger Llama-8B variant
# to a separate GPU. Set to the integer device id.
SLM_GPU_DEVICE=1

# Optional defense-in-depth shared secret. When set, every inference endpoint
# (/translate, /classify, /extract, /summarize, /ner) requires a matching
# X-Models-Secret header and returns 401 otherwise (/health stays open). The
# legba runtime must present the SAME value via its MODELS_API_SECRET env.
# Leave BLANK to disable (the service is already deployment-mitigated by the
# 127.0.0.1/network-internal-only bind + caddy basic_auth).
LEGBA_MODELS_API_SECRET=
