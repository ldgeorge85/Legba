# legba-media — env for deploying the hosted media-extraction service.
#
# Copy to `.env` on the deploy host (`.env` is gitignored). The SHIPPED service
# (no model wired) needs NONE of these set — it deploys, health-checks, and
# serves the declared media seam (HTTP 503 on each extraction kind, never a
# fabricated transcript/caption). These knobs only matter once a real backend
# is wired in app/main.load_backends().

# Comma-separated extraction kinds that have a REAL backend wired + registered
# in app/main.load_backends() (valid: transcribe,caption,ocr,detect). Leave
# BLANK to serve the seam (every kind returns 503). Listing a kind whose
# backend is not actually wired makes the service refuse to start (fail-loud,
# so you never serve a 503 you think is live).
LEGBA_MEDIA_BACKENDS=

# Install PyTorch (cu124 wheels) on first start. Set to 1 only when a model
# backend needs it; the seam service is CPU-only and needs no torch.
LEGBA_MEDIA_INSTALL_TORCH=0

# Optional defense-in-depth shared secret. When set, every extraction endpoint
# requires a matching X-Models-Secret header and returns 401 otherwise
# (/health stays open). The Legba runtime presents the SAME value as its
# MODELS_API_PASS (Basic-Auth password reused as the header — see the runtime
# media client). Leave BLANK to disable (service is loopback/internal-only).
LEGBA_MEDIA_API_SECRET=

# Port the service binds inside the container (default 8800).
LEGBA_MEDIA_PORT=8800
