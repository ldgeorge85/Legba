# NOTE (2026-05-23): This unit is retained as an ALTERNATIVE bring-up
# path. The canonical bring-up is now container-mode via
# `docker compose --profile runtime up -d` (see docs/RUNBOOK.md §2 +
# §13). For host-mode + containerized daprd sidecar, also set
# `LEGBA_DAPR_APP_CHANNEL=host.docker.internal` in `.env` so the
# sidecar dispatches into the host process. Use this systemd unit
# only when docker daemon access for the legba app images is
# unavailable on the host.

[Unit]
Description=Legba Runtime Dapr (host-mode fallback; canonical bring-up is `docker compose --profile runtime up -d`)
Documentation=file:///usr/local/deployments/active/legba/docs/RUNBOOK.md
After=docker.service network-online.target legba-registry.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/local/deployments/active/legba
EnvironmentFile=/usr/local/deployments/active/legba/.env
Environment=LEGBA_DATA_PG_HOST=127.0.0.1
Environment=LEGBA_DATA_PG_PORT=5432
Environment=LEGBA_DATA_PG_USER=legba
Environment=LEGBA_DATA_PG_PASSWORD=legba
Environment=LEGBA_DATA_PG_DB=legba
Environment=LEGBA_DATA_NATS_URL=nats://127.0.0.1:4222
Environment=LEGBA_DATA_REDIS_HOST=127.0.0.1
Environment=LEGBA_DATA_QDRANT_HOST=127.0.0.1
# Match docker-compose daprd sidecar's `-app-port 6090` so daprd can dispatch.
Environment=LEGBA_DAPR_HOST_PORT=6090
# daprd is on the host network via the docker-compose port-mapping.
Environment=DAPR_HTTP_PORT=3500
Environment=DAPR_GRPC_PORT=50001
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m legba.runtime.dapr_host
StandardOutput=append:/usr/local/deployments/active/legba/logs/runtime-dapr.log
StandardError=append:/usr/local/deployments/active/legba/logs/runtime-dapr.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
